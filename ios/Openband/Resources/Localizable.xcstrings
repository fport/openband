            "state": "translated",
            "value": "Web erişimi"
          }
        }
      }
    },
    "Web access is already on (%@). To switch servers, turn it off first in Band › Openband settings › Web access.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web erişimin zaten açık (%@). Başka bir sunucuya geçmek için önce Bant › Openband ayarları › Web erişimi'nden kapat."
          }
        }
      }
    },
    "Web access is off and your data on the server is deleted.": {
