      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraftan okunan vücut yağı kaba bir aralıktır, ölçüm değildir ve Openband bunu Apple Health'e yazmaz. Tıbbi tavsiye değildir."
