        }
      }
    },
    "Model names change faster than apps ship, so this field is yours to edit. It must be a model that can see images.": {
      "comment": "Footnote explaining that the model field is editable by the user, and that it must be a model that can see images.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model adları uygulamalardan hızlı değişir, bu yüzden bu alan senin. Görsel görebilen bir model olmalı."
          }
        }
      }
    },
    "Moderate": {
