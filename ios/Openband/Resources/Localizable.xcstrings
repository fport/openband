        }
      }
    },
    "The model answered, but not as asked. Try another model name.": {
      "comment": "Error message when the AI model responds correctly but not as expected.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model yanıt verdi ama istendiği gibi değil. Başka bir model adı dene."
