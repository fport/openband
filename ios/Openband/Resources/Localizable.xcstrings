    "%@ readings on this phone. Parsing again rebuilds sleep, minutes and scores from the stored raw files.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda %@ ölçüm var. Yeniden çözmek; uykuyu, dakika verisini ve skorları saklanan ham dosyalardan baştan kurar."
          }
